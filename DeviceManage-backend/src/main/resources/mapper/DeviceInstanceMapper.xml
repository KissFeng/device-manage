<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="chat.hbcit.devicemanagebackend.mapper.DeviceInstanceMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="chat.hbcit.devicemanagebackend.entity.DeviceInstance">
        <id column="id" property="id"/>
        <result column="device_id" property="deviceId"/>
        <result column="instance_name" property="instanceName"/>
        <result column="location" property="location"/>
        <result column="status" property="status"/>
        <result column="description" property="description"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 根据设备ID查询所有设备实例 -->
    <select id="selectByDeviceId" resultMap="BaseResultMap">
        SELECT
            id,
            device_id,
            instance_name,
            location,
            status,
            description,
            created_at,
            updated_at
        FROM device_instances
        WHERE device_id = #{deviceId}
        ORDER BY instance_name ASC
    </select>

    <!-- 查询设备实例（包含是否已借出信息） -->
    <select id="selectWithBorrowStatus" resultMap="BaseResultMap">
        SELECT
            di.id,
            di.device_id,
            di.instance_name,
            di.location,
            di.status,
            di.description,
            di.created_at,
            di.updated_at
        FROM device_instances di
        WHERE di.device_id = #{deviceId}
        ORDER BY di.instance_name ASC
    </select>

</mapper>

